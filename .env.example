# Copy to .env and fill in.

# Pangram API key (https://www.pangram.com -> dashboard -> API). Optional: leave blank
# to make the pane ask each user for their own key. Never set this on a public host —
# anyone who finds the proxy could spend your credits.
PANGRAM_API_KEY=

# Optional model selector from GET /models. Blank prefers pangram-4, then "default".
PANGRAM_MODEL=

# Where the pane is served from. Baked into manifest.xml by `npm run manifest`.
#   local dev:   https://localhost:3939
#   your site:   https://example.com/pangram   (see README, "Hosting on your own site")
ADDIN_BASE_URL=https://localhost:3939

# Port for the local HTTPS server (must match ADDIN_BASE_URL when running locally).
PORT=3939
