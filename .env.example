# Local development only. Copy to .env and fill in. (.env is never deployed.)

# Pangram API key (https://www.pangram.com -> dashboard -> API). Used ONLY by the local
# server (`npm start`). Leave blank to paste a key in the pane instead. The hosted
# deployment ignores this variable: every user brings their own key.
PANGRAM_API_KEY=

# Optional model selector from GET /models. Blank prefers pangram-4, then "default".
PANGRAM_MODEL=

# Where the pane is served from. Baked into manifest.xml by `npm run manifest`.
#   local dev:          https://localhost:3939
#   your deployment:    https://pangram.example.com
# On Vercel you normally don't set this: the build uses the project's production domain.
ADDIN_BASE_URL=https://localhost:3939

# Port for the local HTTPS server (must match ADDIN_BASE_URL when running locally).
PORT=3939
