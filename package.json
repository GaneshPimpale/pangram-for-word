{
  "name": "pangram-for-word",
  "version": "0.1.0",
  "private": true,
  "description": "Microsoft Word task-pane add-in that scores the open document with Pangram AI detection.",
  "type": "module",
  "scripts": {
    "start": "node scripts/dev-server.mjs",
    "build": "node scripts/build-site.mjs",
    "manifest": "node scripts/build-manifest.mjs",
    "certs": "office-addin-dev-certs install --days 3650",
    "icons": "python3 scripts/make_icons.py",
    "sideload": "npm run -s manifest && bash scripts/sideload.sh",
    "unsideload": "rm -f \"$HOME/Library/Containers/com.microsoft.Word/Data/Documents/wef/pangram-for-word.xml\""
  },
  "devDependencies": {
    "office-addin-dev-certs": "^3.0.0"
  },
  "engines": {
    "node": ">=20.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GaneshPimpale/pangram-for-word.git"
  },
  "license": "MIT"
}
